[Desktop Entry]
Type=Application
Name=LZ Editor
GenericName=Text Editor
GenericName[ja]=テキストエディタ
Comment=VZ Editor-inspired lightweight native GUI text editor & 2-pane filer
Comment[ja]=往年のVZ Editor風の超軽量ネイティブGUIテキストエディタ＆2画面ファイラー
Exec=lz %F
Icon=lz-editor
Terminal=false
Categories=Utility;TextEditor;
MimeType=text/plain;text/markdown;text/x-csrc;text/x-chdr;text/x-rust;text/x-python;application/json;application/xml;application/x-shellscript;
Keywords=editor;text;vz;filer;
StartupWMClass=lz-editor
